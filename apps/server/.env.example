# Copy to .env and change what you need. Everything has a sensible default.

# Port and address the server listens on (0.0.0.0 = reachable from other computers and phones)
PORT=3000
HOST=0.0.0.0

# Where the database file and the secret for sign-in tokens are kept. Back this folder up.
# DATA_DIR=./data

# Use a different database file name
# DB_FILE=./data/bnhs.db

# ---- Optional: store everything in PostgreSQL (for example Supabase) instead of the local SQLite file.
# Supabase: open your project, press "Connect", choose "Session pooler" and copy the string. Replace
# [YOUR-PASSWORD] with the database password (Project Settings, Database). If the password has symbols
# such as @ # / : write them URL-encoded (%40 %23 %2F %3A). Never commit this file: .env is git-ignored.
# DATABASE_URL=postgresql://postgres.YOURPROJECTREF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#
# The connection is encrypted. To also verify the server's certificate, download Supabase's root
# certificate (Project Settings, Database, SSL configuration) and point to it:
# DATABASE_CA_FILE=./prod-ca-2021.crt
# Connections kept open to the database (default 5; hosted plans allow only a few)
# DATABASE_POOL_MAX=5

# Sign-in tokens are signed with this. Leave it out and a random one is created in DATA_DIR.
# Set it when the server's disk is not permanent (Render, Railway, containers), or everyone is
# signed out at every restart.
# JWT_SECRET=at-least-32-random-characters

# How long a sign-in lasts
# TOKEN_TTL=12h

# Extra browser origins allowed to call the API (comma separated). The Android app and the
# built-in web app already work without this.
# CORS_ORIGINS=https://grades.example.edu.ph

# Where the built web app is (default: ../web/dist)
# WEB_DIR=../web/dist
